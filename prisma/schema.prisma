generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CANDIDATE
  COMPANY
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

model User {
  id           String         @id @default(uuid())
  name         String         
  email        String         @unique
  passwordHash String         @map("password_hash")
  role         UserRole       @default(CANDIDATE)
  status       UserStatus     @default(ACTIVE) 
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  rejectionReason String?

  // Relations
  postedJobs         Job[]         @relation("CompanyPostedJobs")
  applications       Application[]
  candidateProfile   CandidateProfile?
  companyProfile     CompanyProfile?
  candidateInterview Interview[]  @relation("CandidateInterview")
  companyInterview   Interview[]  @relation("CompanyInterview")
 
  @@map("users")
}



enum JobType {
  REMOTE
  HYBRID
  ONSITE
}

enum JobStatus {
  OPEN
  CLOSED
}

// Application Code: prisma.job
// MySQL Table Name: `jobs`

model Job {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  title         String
  jobType       JobType   @map("job_type")
  description   String    @db.Text
  skills        Json      // Stored as JSON array in MySQL: ["Node.js", "TypeScript"]
  salaryMin     Int       @map("salary_min")
  salaryMax     Int       @map("salary_max")
  experienceMax Int?      @map("experience_max")
  experienceMin Int?      @map("experience_min")
  status        JobStatus @default(OPEN)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  company      User          @relation("CompanyPostedJobs", fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]

  @@map("jobs")
}

enum ApplicationStage{
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

model Application{ 
  id          String     @id @default(uuid())
  jobId       String     @map("job_id")
  candidateId String     @map("candidate_id") 
  stage       ApplicationStage  @default(APPLIED)
  resumeKey   String?          @map("resume_url")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  // Relations
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate   User             @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviews  Interview[]

  // Enforce one application per candidate per job- Prevents a candidate from applying to the same job multiple
  @@unique([candidateId, jobId], name: "candidate_job_unique")

  // Optimization indexes for common queries
  @@index([candidateId, createdAt(sort: Desc)])
  @@index([jobId, stage])
  @@map("applications")
}


model CandidateProfile{
  id          String     @id @default(uuid())
  userId      String     @unique
  user        User      @relation(fields:[userId],references:[id], onDelete:Cascade)

  firstName    String
  lastName     String
  phone        String?
  headline     String?  //eg. for 'Full stack developer|MERN & AWS'
  bio          String?     @db.Text
  location     String?
  webSiteUrl   String?
  githubUrl    String?
  linkedinUrl  String?
  skills       Json?  // Array of strings: ["Node.js", "React"]
  //structured experience/education JSON or seperated relations

  resumeKey   String?   

  experience   Json?
  education    Json?

  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("candidate_profiles")
}


model CompanyProfile {
  id            String     @id @default(uuid())
  userId        String     @unique
  user          User      @relation(fields:[userId],references:[id], onDelete:Cascade)

  companyName   String   @map("company_name")
  industry      String?
  companySize   String?  @map("company_size")
  website       String? 
  location      String?
  description   String?  @db.Text
  logoUrl       String?  @map("logo_url")

  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at") 

  @@map("company_profiles")
}


enum InterviewStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EvaluationDesicion {
  HIRED
  REJECTED
  NEXT_ROUND
  PENDING 
}

model Interview {
  id              String     @id @default(uuid())
  applicationId   String     @map("application_id")
  candidateId     String     @map("candidate_id")
  companyId       String     @map("company_id") 
  roomKey         String     @unique @map("room_key")
  scheduledAt     DateTime    @map("scheduled_at")
  status          InterviewStatus    @default(SCHEDULED)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @default(now()) @map("updated_at")


  //Relations
  application   Application     @relation(fields:[applicationId], references:[id],onDelete:Cascade)
  candidate     User            @relation("CandidateInterview",fields:[candidateId],references:[id],onDelete:Cascade)
  company       User            @relation("CompanyInterview",fields:[companyId],references:[id],onDelete:Cascade)

  evaluation    InterviewEvaluation?

  @@index([roomKey])
  @@index([companyId,scheduledAt])
  @@index([candidateId,scheduledAt])
  @@map("interviews")

}

model InterviewEvaluation{
  id                    String               @id @default(uuid())
  interviewId           String               @unique @map("interview_id")
  technicalScore        Int                  @map("technical_score")
  communicationScore    Int                  @map("communication_score")
  problemSolvingScore   Int                  @map("problem_solving_score")
  notes                 String               @db.Text
  decision              EvaluationDesicion   @default(PENDING)
  createdAt             DateTime             @default(now()) @map("created_at")

  //Relations
  interview       Interview     @relation(fields:[interviewId],references:[id],onDelete:Cascade)

  @@map("Interview_evaluations")
  
}